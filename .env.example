# ---------------------------------------------------------------------------
# SePay Payment Gateway
# Docs IPN: https://developer.sepay.vn/en/cong-thanh-toan/IPN
#
# SEPAY_SUCCESS_URL / ERROR_URL / CANCEL_URL = URL trình duyệt quay về (frontend).
#   Local: http://localhost:3000/... là OK (user máy bạn mở được).
#
# SEPAY_IPN_URL = URL SePay server gọi backend (phải PUBLIC HTTPS, không dùng localhost).
#   Local: chạy cloudflared/ngrok trỏ :8080, rồi set:
#     SEPAY_IPN_URL=https://<tunnel-host>/api/payment/sepay-ipn
#   Đồng thời cấu hình cùng URL đó trên SePay:
#     Payment Gateway → Configuration → IPN
#   Auth type = SECRET_KEY; header X-Secret-Key phải khớp SEPAY_SECRET_KEY.
#   Chi tiết cầm tay: docs/SEPAY_SETUP.md
# ---------------------------------------------------------------------------
SEPAY_ENV=production
SEPAY_MERCHANT_ID=SP-LIVE-NX3AAB5B
SEPAY_SECRET_KEY=spsk_live_7P92E5XYPkpNKJwkokzUcFKbuht253cU
SEPAY_SUCCESS_URL=http://localhost:3000/payment/sepay-return
SEPAY_ERROR_URL=http://localhost:3000/payment/sepay-return?result=error
SEPAY_CANCEL_URL=http://localhost:3000/payment/sepay-return?result=cancel
SEPAY_IPN_URL=http://localhost:8080/api/payment/sepay-ipn

# Server
PORT=8080
