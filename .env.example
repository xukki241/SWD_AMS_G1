# =============================================================================
# AMS root environment template
# Copy to `.env` (gitignored) and fill real values. Never commit `.env`.
#
# Used by: docker compose (interpolation) and local backend runs that load
# the same variable names (see ams-backend/src/main/resources/application.yml).
#
# Frontend env lives separately:
#   cp ams-frontend/.env.local.example ams-frontend/.env.local
#
# SePay IPN (tunnel + portal): docs/SEPAY_SETUP.md
# Demo status / seed inventory: docs/PROJECT_STATUS.md
# =============================================================================

# --- Database (local JVM against host Postgres; Docker Compose overrides DB_URL) ---
# Host Postgres via compose maps 5433 -> container 5432.
# If backend runs on the host against compose Postgres, use port 5433:
#   DB_URL=jdbc:postgresql://localhost:5433/ams_db
DB_URL=jdbc:postgresql://localhost:5432/ams_db
DB_USERNAME=ams_user
DB_PASSWORD=ams_password

# --- JWT (use a long random string in any shared/production environment) ---
JWT_SECRET=ams-super-secret-jwt-key-for-development-only-minimum-256-bits-long-key

# --- Cloudinary (file/image hosting; sandbox/demo project values OK for local) ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- VNPay Sandbox (public sandbox credentials from VNPay docs / portal) ---
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost:3000/payment/return
VNPAY_IPN_URL=http://localhost:8080/api/payment/vnpay-ipn

# --- SePay Payment Gateway ---
# IPN docs: https://developer.sepay.vn/en/cong-thanh-toan/IPN
#
# Browser return URLs may stay on localhost for local demos.
# SEPAY_IPN_URL must be a PUBLIC HTTPS URL when you want ORDER_PAID → ACTIVE
# via IPN (cloudflared/ngrok). Do not put live merchant secrets in git.
# Hands-on setup: docs/SEPAY_SETUP.md
SEPAY_ENV=production
SEPAY_MERCHANT_ID=your-sepay-merchant-id
SEPAY_SECRET_KEY=your-sepay-secret-key
SEPAY_SUCCESS_URL=http://localhost:3000/payment/sepay-return
SEPAY_ERROR_URL=http://localhost:3000/payment/sepay-return?result=error
SEPAY_CANCEL_URL=http://localhost:3000/payment/sepay-return?result=cancel
SEPAY_IPN_URL=http://localhost:8080/api/payment/sepay-ipn
# Must match SePay portal Unit ID (e.g. SP-LIVE-NX3AAB5B). Wrong merchant → instant Failed.
# Optional: BANK_TRANSFER | NAPAS_BANK_TRANSFER | CARD. Empty = omit (merchant default).
SEPAY_PAYMENT_METHOD=BANK_TRANSFER

# --- Local file storage (stream materials / submissions when not using Cloudinary path) ---
# Docker Compose sets these on the backend service; host runs can leave defaults.
FILE_STORAGE_PATH=./storage/files
FILE_STORAGE_BASE_URL=http://localhost:8080

# --- Gemini AI (course outline generation) ---
# Required for "Generate Outline with AI". Get a key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Optional: request timeout in seconds (default 30)
GEMINI_TIMEOUT_SECONDS=30

# --- Server ---
PORT=8080
