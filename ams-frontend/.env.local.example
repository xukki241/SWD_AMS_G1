# Frontend public env (copy to .env.local — gitignored)
# NEXT_PUBLIC_* values are inlined at build time; restart/rebuild after changes.
# Backend/Compose secrets live in the repo-root .env (see ../.env.example).

NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
